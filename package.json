{
  "name": "ShiguangDiary",
  "displayName": "拾光日记",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "pods": "cd ios && pod install",
    "clean:android": "cd android && ./gradlew clean",
    "clean:metro": "rm -rf $TMPDIR/metro-*",
    "clean:node": "rm -rf node_modules && npm install",
    "reset": "npm run clean:metro && npm run clean:android",
    "ts:check": "tsc --noEmit",
    "doctor": "react-native doctor"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.2",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@shopify/flash-list": "^1.7.1",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.18.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-fast-image": "^8.6.3",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "2.23.1",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-image-picker": "^7.1.2",
    "react-native-image-zoom-viewer": "^3.0.1",
    "react-native-keyboard-controller": "^1.14.0",
    "react-native-mmkv": "2.12.2",
    "react-native-pell-rich-editor": "^1.9.0",
    "react-native-qrcode-svg": "^6.3.2",
    "react-native-reanimated": "3.16.0",
    "react-native-safe-area-context": "^4.14.0",
    "react-native-screens": "4.1.0",
    "react-native-share": "^11.0.3",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.8.0",
    "react-native-tts": "^4.1.1",
    "react-native-vector-icons": "^10.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/eslint-config": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.2.6",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
